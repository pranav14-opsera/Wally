# Wally environment configuration
# Copy to .env and fill in real values for local development.
# Validated at boot by src/config/schema.ts (zod). Missing/invalid values
# cause the app to fail fast with a descriptive error listing every issue.

# --- Provider selection (zero-hardcoding: these drive which adapters load) ---

# Which cloud provider's adapters to use. (optional, default: local)
# One of: aws | gcp | azure | local
CLOUD_PROVIDER=local

# Which database engine's repository adapter to use. (optional, default: postgres)
# One of: postgres | mongo
DATA_ENGINE=postgres

# Which compute runner executes load-test jobs. (optional, default: local)
# One of: local | cloud
COMPUTE_RUNNER=local

# --- Postgres (required only when DATA_ENGINE=postgres) ---

POSTGRES_DB=wally
POSTGRES_USER=wally
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Mongo (required only when DATA_ENGINE=mongo) ---

MONGO_URI=mongodb://localhost:27017
MONGO_INITDB_DATABASE=wally

# Days audit log entries are retained before automatic purge. (optional, default: 365)
# Drives the Mongoose AuditLog TTL index when DATA_ENGINE=mongo.
AUDIT_LOG_RETENTION_DAYS=365

# --- Redis (required) ---

# Connection string for BullMQ queues and rate limiting.
REDIS_URL=redis://localhost:6379

# --- Auth (required) ---

# Filesystem paths to the RS256 key pair used to sign/verify JWTs.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# --- Secrets (required only when CLOUD_PROVIDER=local) ---

# AES-256 key material for LocalSecretsAdapter. Must be at least 32 characters.
LOCAL_SECRETS_MASTER_KEY=change-me-to-a-random-32-plus-character-string

# --- Storage (optional, only used when CLOUD_PROVIDER=local) ---

# Base directory FilesystemStorageAdapter reads/writes under. Mounted as a
# Docker volume in docker-compose.yml.
STORAGE_LOCAL_PATH=./data/storage

# --- App (optional, all have defaults) ---

# Pino log level. One of: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Node environment.
NODE_ENV=development

# HTTP port the gateway listens on.
PORT=3000
