{
  "name": "wally",
  "version": "0.1.0",
  "description": "Wally — Walmart Tool Integration Platform",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "build": "tsc",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:contract": "bash scripts/run-contract-tests.sh",
    "test:contract:postgres": "DATA_ENGINE=postgres vitest run --config vitest.config.contract.ts --reporter=json --outputFile=.contract-results-postgres.json",
    "test:contract:mongo": "DATA_ENGINE=mongo vitest run --config vitest.config.contract.ts --reporter=json --outputFile=.contract-results-mongo.json",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:types": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e && npm run test:types",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fastify": "^5.11.3",
    "mongoose": "^9.9.2",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.0.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "typescript": "^5.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^1.6.1"
  }
}
